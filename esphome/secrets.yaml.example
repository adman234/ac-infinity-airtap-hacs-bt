# Copy to secrets.yaml in your ESPHome directory and fill in.
# secrets.yaml is gitignored — never commit the real one.

wifi_ssid: "your-ssid"
wifi_password: "your-wifi-password"

# `esphome wizard` / the dashboard can generate this: 32 bytes, base64.
airtap_api_key: "base64-32-byte-key=="

ota_password: "your-ota-password"
ap_password: "fallback-hotspot-password"
web_password: "local-web-ui-password"
